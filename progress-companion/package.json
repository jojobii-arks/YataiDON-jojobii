{
  "name": "taiko-stats",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k -n server,web -c orange,cyan \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx server/index.ts",
    "dev:server:watch": "tsx watch server/index.ts",
    "electron:dev": "concurrently -k -n server,web,electron -c orange,cyan,magenta \"pnpm dev:server\" \"pnpm dev:web\" \"pnpm electron:wait\"",
    "electron:wait": "wait-on tcp:127.0.0.1:3789 tcp:127.0.0.1:5173 && wait-on http://127.0.0.1:3789/api/health http://127.0.0.1:5173 && cross-env PROGRESS_ELECTRON_DEV=1 PROGRESS_SPAWN_SERVER=0 electron .",
    "electron:start": "pnpm build && cross-env PROGRESS_STATIC=1 PROGRESS_SPAWN_SERVER=1 PROGRESS_ELECTRON_DEV=0 electron .",
    "build": "tsc -b && vite build",
    "start": "cross-env PROGRESS_STATIC=0 tsx server/index.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "rescan": "tsx -e \"fetch('http://127.0.0.1:3789/api/rescan',{method:'POST'}).then(r=>r.json()).then(console.log)\""
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.10",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^41.0.2",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wait-on": "^9.0.3"
  }
}
